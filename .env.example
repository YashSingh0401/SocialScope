# SocialScope Configuration Template
# Copy this file to .env and configure your desired credentials.
# Note: Zero-auth modes work for Reddit (public subreddits) and Telegram (public channels) without any API keys.

# Database connection string (PostgreSQL 17)
DATABASE_URL=postgresql://socialscope:password@127.0.0.1:55432/socialscope

# --- Reddit Data API ---
# Create a free "script" app at https://www.reddit.com/prefs/apps
# Optional: Zero-auth public JSON fetching is enabled when these are omitted.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=SocialScope-Intelligence/1.0 (Enterprise Research)

# --- YouTube Data API v3 ---
# Obtain a free API key (10,000 units/day) from https://console.cloud.google.com
YOUTUBE_API_KEY=

# --- Telegram API ---
# Bot API: Obtain from @BotFather on Telegram (for channels/groups where bot is admin)
TELEGRAM_BOT_TOKEN=
# MTProto Client (optional): Obtain from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
